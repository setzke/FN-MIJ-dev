var m_epicfight = mods.get("epicfight");
if (m_epicfight != null) {
    var warn = Startup.addCrashWarning("If you are seeing this, you have manually added the <strong>Epic Fight</strong> mod to the modpack. <strong>Epic Fight</strong> is known to cause frequent crashes and is widely incompatible with other mods. If you would like a more stable alternative to <strong>Epic Fight</strong>, you may want to try out the <strong>Better Combat</strong> mod.");
    warn.withModActions(m_epicfight);
    Startup.markForCrash();
}

var m_valkyrienskies = mods.get("valkyrienskies");
if (m_valkyrienskies != null) {
    var warn = Startup.addCrashWarning("If you are seeing this, you have manually added the <strong>Valkyrien Skies</strong> mod to the modpack. <strong>Valkyrien Skies</strong> has many incompatibilities, and it's not possible to add it to a pre-existing modpack without experiencing many crashes.");
    warn.withModActions(m_valkyrienskies);
    Startup.markForCrash();
}

var m_optifine = mods.get("optifine");
if (m_optifine != null) {
    var warn = Startup.addCrashWarning("If you are seeing this, you have manually added the <strong>Optifine mod</strong> to the modpack. The <strong>Optifine</strong> mod is completely unnecessary, and has been for almost ten years now. Alternatives such as Sodium/Xenon and Iris/Oculus are already present in all modern modpacks.");
    warn.withModActions(m_optifine);
    Startup.markForCrash();
}

